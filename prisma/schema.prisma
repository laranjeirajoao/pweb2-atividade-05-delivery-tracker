// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Motorista { 
  id    Int     @id @default(autoincrement()) 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  nome String
  cpf String @unique
  placa_veiculo String
  status MotoristaStatus @default(ATIVO)
  entregas Entrega[]
} 

enum MotoristaStatus{
  ATIVO
  INATIVO
}

model Entrega {
  id    Int     @id @default(autoincrement()) 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  descricao String
  origem String
  destino String
  status EntregaStatus @default(CRIADA)
  motorista Motorista? @relation(fields: [motorista_id], references: [id])
  motorista_id Int?
  criador Usuario? @relation(fields: [criador_id], references: [id])
  criador_id Int?
  historico EventoEntrega[]
}

enum EntregaStatus{
  CRIADA
  EM_TRANSITO
  ENTREGUE
  CANCELADA
}

model EventoEntrega {
  id    Int     @id @default(autoincrement()) 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  descricao String
  entrega Entrega @relation(fields: [entrega_id], references: [id], onDelete: Cascade)
  entrega_id Int
}

// prisma/schema.prisma

enum Papel {
  OPERADOR
  GESTOR
}

model Usuario {
  id           Int            @id @default(autoincrement())
  nome         String
  email        String         @unique
  senha        String
  papel        Papel          @default(OPERADOR)
  criadoEm    DateTime       @default(now()) @map("criado_em")
  refreshTokens RefreshToken[]
  entregas_criadas Entrega[]
  @@map("usuarios")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  usuarioId Int      @map("usuario_id")
  expiresAt DateTime @map("expires_at")
  criadoEm DateTime @default(now()) @map("criado_em")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}