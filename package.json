{
  "name": "pweb2-delivery-tracker",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/laranjeirajoao/pweb2-delivery-tracker#readme",
  "bugs": {
    "url": "https://github.com/laranjeirajoao/pweb2-delivery-tracker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laranjeirajoao/pweb2-delivery-tracker.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "nodemon src/server.js",
    "dev": "node --watch src/server.js",
    "test": "npm run test:unit",
    "test:unit": "NODE_ENV=test DOTENV_CONFIG_PATH=.env.test node --experimental-vm-modules node_modules/.bin/jest --config jest.unit.config.js",
    "test:unit:watch": "NODE_ENV=test DOTENV_CONFIG_PATH=.env.test node --experimental-vm-modules node_modules/.bin/jest --config jest.unit.config.js --watch",
    "test:unit:coverage": "NODE_ENV=test DOTENV_CONFIG_PATH=.env.test node --experimental-vm-modules node_modules/.bin/jest --config jest.unit.config.js --coverage",
    "test:integration": "NODE_ENV=test DOTENV_CONFIG_PATH=.env.test node --experimental-vm-modules node_modules/.bin/jest --config jest.integration.config.js",
    "test:integration:watch": "NODE_ENV=test DOTENV_CONFIG_PATH=.env.test node --experimental-vm-modules node_modules/.bin/jest --config jest.integration.config.js --watch",
    "test:integration:coverage": "NODE_ENV=test DOTENV_CONFIG_PATH=.env.test node --experimental-vm-modules node_modules/.bin/jest --config jest.integration.config.js --coverage",
    "test:e2e": "NODE_ENV=test DOTENV_CONFIG_PATH=.env.test playwright test --config frontend/playwright.config.js",
    "test:e2e:ui": "NODE_ENV=test DOTENV_CONFIG_PATH=.env.test playwright test --config frontend/playwright.config.js --ui",
    "test:e2e:headed": "NODE_ENV=test DOTENV_CONFIG_PATH=.env.test playwright test --config frontend/playwright.config.js --headed",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "bcrypt": "^6.0.0",
    "connect-flash": "^0.1.1",
    "dotenv": "^17.4.1",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "method-override": "^3.0.0",
    "nodemon": "^3.1.14",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@playwright/test": "^1.61.0",
    "jest": "^30.4.2",
    "prisma": "^7.7.0",
    "supertest": "^7.2.2"
  }
}
